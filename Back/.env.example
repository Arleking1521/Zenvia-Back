SECRET_KEY=change-me

DEBUG=False

DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=change-me
DB_PORT=change-me

ALLOW_FAKE_PAYMENTS=True
FAKE_PAYMENT_ALLOWED_EMAILS=test@example.com
# Google Play Billing. JSON-файл service account храните вне Git.
GOOGLE_PLAY_PACKAGE_NAME=kz.zenvia.kids
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/absolute/path/to/google-play-service-account.json

# Email / SMTP (Django 6.1 MAILERS)
# Для production переключите backend на SMTP.
MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=15
DEFAULT_FROM_EMAIL=Zenvia Kids <noreply@example.com>

# Удаление аккаунта через сайт
ACCOUNT_DELETION_CODE_TTL_MINUTES=15
ACCOUNT_DELETION_CODE_RESEND_SECONDS=60
ACCOUNT_DELETION_CODE_MAX_ATTEMPTS=5

